{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torrent404",
  "mainBinaryName": "Torrent404",
  "version": "0.1.0",
  "identifier": "io.github.yongliu404.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Torrent404",
        "width": 1180,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Torrent404：本地 Torrent 搜索与下载客户端",
    "longDescription": "Torrent404 是中文优先、在本机运行的 Torrent 搜索与下载桌面客户端。",
    "resources": {
      "sidecar/node.exe": "sidecar/node.exe",
      "sidecar/bootstrap.mjs": "sidecar/bootstrap.mjs",
      "sidecar/download-service.mjs": "sidecar/download-service.mjs",
      "sidecar/search-service.mjs": "sidecar/search-service.mjs",
      "sidecar/core/": "sidecar/core/",
      "sidecar/node_modules/": "sidecar/node_modules/"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
