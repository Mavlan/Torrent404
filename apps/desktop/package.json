{
  "name": "@torlink/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "涌流404 Windows desktop shell",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:sidecar": "node ../../scripts/prepare-sidecar.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run && node --test src-tauri/sidecar/search-service.test.mjs src-tauri/sidecar/download-service.test.mjs",
    "build": "npm run prepare:sidecar && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@torlink/i18n": "0.1.0",
    "@torlink/protocol": "0.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "vite": "8.2.2"
  }
}
